"""TensorForge — cuda/kernels/ Bazel build (Wave 4 / T17-T28).

Elementwise, softmax, layernorm, GEMM, im2col, col2im kernels live here.
"""

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

package(default_visibility = ["//visibility:public"])

# Elementwise (add, mul, relu, leaky_relu, sigmoid, tanh) — T17/T18/T19.
cuda_library(
    name = "elementwise",
    srcs = ["elementwise.cu"],
    hdrs = ["elementwise.cuh"],
    deps = [
        "//cuda:context",
        "//tensor:tensor_types",
    ],
)

cc_test(
    name = "elementwise_add_test",
    srcs = ["elementwise_add_test.cpp"],
    deps = [
        ":elementwise",
        "//cuda:context",
        "//cuda/memory:allocator",
        "//tensor:factory",
        "//tensor:tensor_core",
        "//tensor:tensor_types",
        "//third_party/doctest:doctest",
    ],
    tags = ["gpu", "fp32", "fp16", "bf16"],
)

cc_test(
    name = "elementwise_mul_test",
    srcs = ["elementwise_mul_test.cpp"],
    deps = [
        ":elementwise",
        "//cuda:context",
        "//cuda/memory:allocator",
        "//tensor:factory",
        "//tensor:tensor_core",
        "//tensor:tensor_types",
        "//third_party/doctest:doctest",
    ],
    tags = ["gpu", "fp32", "fp16", "bf16"],
)

cc_test(
