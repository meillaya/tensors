"""TensorForge — benchmarks/ Bazel build (Wave 5 / T25, T48, T49).

GPU-side op-level benchmarks. Each is a `cc_binary` (NOT `cc_test`) that
prints structured output and exits 0 — they are run via `bazelisk run`,
not `bazelisk test`.

Targets:
  * gemm_bench  (T25) — naive/tiled/optimized GEMM vs cuBLAS, FP32/FP16/BF16.
  * op_bench    (T48) — full op-level harness: add, mul, relu, sigmoid,
    tanh, matmul, softmax, layernorm. Used for the
    benchmarks/results/op_bench_results.json report.
  * train_bench (T49) — MLP-on-MNIST forward throughput benchmark.
    CPU Float32 forward-only (Linear/ReLU/CEL are CPU in v1, and the
    autograd requires_grad propagation bug blocks reliable backward
    timing). Writes benchmarks/results/train_bench_results.json.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

package(default_visibility = ["//visibility:public"])

# GEMM benchmark binary — links the gemm library + cuBLAS via the
# rules_cuda-sourced hermetic toolkit alias @cuda//:cublas. Also pulls
# in the CUDA allocator with alwayslink so its static initializer
# registers the GPU storage allocator (Tensor::full needs this).
cc_binary(
    name = "gemm_bench",
    srcs = ["gemm_bench.cpp"],
    deps = [
        "//cuda/kernels:gemm",
        "//cuda/memory:allocator",
        "//tensor:factory",
        "//tensor:tensor_core",
        "//tensor:tensor_types",
        "@cuda//:cublas",
    ],
    tags = ["gpu", "bench"],
)

# Op-level benchmark binary (T48). Times every operator the runtime
# exposes on CUDA: add, mul, relu, sigmoid, tanh, matmul (optimized),
# softmax, layer-norm. Elementwise ops dispatch through Tensor's public
# API; matmul/softmax/layernorm call the low-level launch_* functions
# directly (the Tensor methods are CPU-only in v1).
#
# Deps pull in the CUDA allocator (alwayslink) so its static initializer
# registers the GPU storage allocator that Tensor::full requires.
cc_binary(
    name = "op_bench",
    srcs = ["op_bench.cpp"],
    deps = [
        "//cuda:context",
        "//cuda/kernels:elementwise",
        "//cuda/kernels:gemm",
        "//cuda/kernels:layernorm",
        "//cuda/kernels:softmax",
        "//cuda/memory:allocator",
        "//tensor:factory",
        "//tensor:tensor_core",
        "//tensor:tensor_types",
    ],
    tags = ["gpu", "bench"],
)

# Training throughput benchmark (T49). Times MLP-on-MNIST forward
# through nn::Linear + nn::ReLU + nn::CrossEntropyLoss (CPU Float32).
# Backward is intentionally omitted: the autograd requires_grad
# propagation bug makes it unreliable to time in v1.
cc_binary(
    name = "train_bench",
    srcs = ["train_bench.cpp"],
    deps = [
        "//data:mnist",
        "//nn:cross_entropy_loss",
        "//nn:activations",
        "//nn:linear",
        "//tensor:factory",
        "//tensor:tensor_core",
        "//tensor:tensor_types",
    ],
    tags = ["bench"],
)
