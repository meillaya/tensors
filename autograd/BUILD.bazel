load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "autograd_core",
    srcs = [
        "AccumulateGrad.cpp",
        "AutogradMeta.cpp",
        "Engine.cpp",
        "InputBuffer.cpp",
        "SavedTensor.cpp",
        "TensorAutograd.cpp",
    ],
    hdrs = [
        "AccumulateGrad.hpp",
        "AutogradMeta.hpp",
        "Engine.hpp",
        "InputBuffer.hpp",
        "IntrusivePtr.hpp",
        "Node.hpp",
        "SavedTensor.hpp",
        "ops/AddBackward.hpp",
        "ops/LayerNormBackward.hpp",
        "ops/MatmulBackward.hpp",
        "ops/MulBackward.hpp",
        "ops/ReluBackward.hpp",
        "ops/SoftmaxBackward.hpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//tensor:factory",
        "//tensor:tensor_core",
    ],
)

# T33: header-only library of autograd backward Nodes.
# Each operation's gradient is implemented as an inline class deriving from
# autograd::Node, so consumers (operators, modules) can include just the
# header they need without pulling the full autograd_core binary.
cc_library(
    name = "ops",
    hdrs = glob(["ops/*.hpp"]),
    visibility = ["//visibility:public"],
    deps = [":autograd_core"],
)

cc_test(
    name = "node_test",
    srcs = ["node_test.cpp"],
    deps = [":autograd_core", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_test(
    name = "autograd_meta_test",
    srcs = ["autograd_meta_test.cpp"],
    deps = [":autograd_core", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_test(
    name = "engine_test",
    srcs = ["engine_test.cpp"],
    deps = [":autograd_core", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

# T33: add/mul backward — exercises Tensor::operator+/* wirer slot end-to-end.
cc_test(
    name = "autograd_add_mul_test",
    srcs = ["ops/autograd_add_mul_test.cpp"],
    deps = [
        ":autograd_core",
        ":ops",
        "//tensor:factory",
        "//third_party/doctest:doctest",
    ],
    tags = ["cpu", "autograd", "fp32"],
)
