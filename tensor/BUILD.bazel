load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "tensor_types",
    hdrs = ["Shape.hpp", "Stride.hpp", "Dtype.hpp", "Device.hpp"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "shape_test",
    srcs = ["shape_test.cpp"],
    deps = [":tensor_types", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_test(
    name = "stride_test",
    srcs = ["stride_test.cpp"],
    deps = [":tensor_types", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_test(
    name = "dtype_test",
    srcs = ["dtype_test.cpp"],
    deps = [":tensor_types", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_test(
    name = "device_test",
    srcs = ["device_test.cpp"],
    deps = [":tensor_types", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_library(
    name = "storage",
    srcs = ["Storage.cpp", "CPUStorageAllocator.cpp"],
    hdrs = ["Storage.hpp", "CPUStorageAllocator.hpp"],
    visibility = ["//visibility:public"],
    deps = [":tensor_types"],
)

cc_test(
    name = "storage_test",
    srcs = ["storage_test.cpp"],
    deps = [":storage", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_library(
    name = "tensor_core",
    srcs = ["Tensor.cpp", "Storage.cpp", "CPUStorageAllocator.cpp"],
    hdrs = ["Tensor.hpp", "Storage.hpp", "CPUStorageAllocator.hpp", "Shape.hpp", "Stride.hpp", "Dtype.hpp", "Device.hpp"],
    visibility = ["//visibility:public"],
    deps = [":tensor_types", ":storage"],
)

cc_test(
    name = "tensor_test",
    srcs = ["tensor_test.cpp"],
    deps = [":tensor_core", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)
