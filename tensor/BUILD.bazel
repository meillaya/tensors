load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")

cc_library(
    name = "tensor_types",
    hdrs = ["Shape.hpp", "Stride.hpp", "Dtype.hpp", "Device.hpp"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "shape_test",
    srcs = ["shape_test.cpp"],
    deps = [":tensor_types", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_test(
    name = "stride_test",
    srcs = ["stride_test.cpp"],
    deps = [":tensor_types", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_test(
    name = "dtype_test",
    srcs = ["dtype_test.cpp"],
    deps = [":tensor_types", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_test(
    name = "device_test",
    srcs = ["device_test.cpp"],
    deps = [":tensor_types", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_library(
    name = "storage",
    srcs = ["Storage.cpp", "CPUStorageAllocator.cpp"],
    hdrs = ["Storage.hpp", "CPUStorageAllocator.hpp"],
    visibility = ["//visibility:public"],
    deps = [":tensor_types"],
)

cc_test(
    name = "storage_test",
    srcs = ["storage_test.cpp"],
    deps = [":storage", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

# tensor_core — CPU compiled (g++). The CUDA codepath in Tensor.cpp is
# reached through a function-pointer registration so we don't include
# cuda_runtime.h from this translation unit. The CUDA allocator and kernel
# libraries register themselves via their static initializers.
cc_library(
    name = "tensor_core",
    srcs = ["Tensor.cpp", "Storage.cpp", "CPUStorageAllocator.cpp"],
    hdrs = ["Tensor.hpp", "Storage.hpp", "CPUStorageAllocator.hpp", "AutogradWirer.hpp", "Shape.hpp", "Stride.hpp", "Dtype.hpp", "Device.hpp"],
    visibility = ["//visibility:public"],
    deps = [
        ":tensor_types",
        ":storage",
        "//cuda:kernel_registry",
    ],
)

cc_test(
    name = "tensor_test",
    srcs = ["tensor_test.cpp"],
    deps = [":tensor_core", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_library(
    name = "slicing",
    srcs = ["slicing.cpp"],
    hdrs = ["slicing.hpp"],
    visibility = ["//visibility:public"],
    deps = [":tensor_core", "//third_party/mdspan:mdspan"],
)

cc_test(
    name = "slicing_test",
    srcs = ["slicing_test.cpp"],
    deps = [":slicing", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_library(
    name = "factory",
    srcs = ["factory.cpp", "shape_ops.cpp", "slicing.cpp", "Tensor.cpp", "Storage.cpp", "CPUStorageAllocator.cpp"],
    hdrs = ["factory.hpp", "shape_ops.hpp", "slicing.hpp", "Tensor.hpp", "Storage.hpp", "CPUStorageAllocator.hpp", "AutogradWirer.hpp", "Shape.hpp", "Stride.hpp", "Dtype.hpp", "Device.hpp"],
    visibility = ["//visibility:public"],
    deps = [":tensor_types", ":storage", "//cuda:kernel_registry", "//third_party/mdspan:mdspan"],
)

cc_test(
    name = "factory_test",
    srcs = ["factory_test.cpp"],
    deps = [":factory", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_test(
    name = "shape_ops_test",
    srcs = ["shape_ops_test.cpp"],
    deps = [":factory", "//third_party/doctest:doctest"],
    tags = ["cpu"],
)

cc_test(
    name = "to_test",
    srcs = ["tensor_to_test.cpp"],
    deps = [
        ":factory",
        ":tensor_core",
        "//cuda:context",
        "//cuda:kernel_registry",
        "//cuda/memory:allocator",
        "//third_party/doctest:doctest",
    ],
    tags = ["cpu", "gpu"],
)